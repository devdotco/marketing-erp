# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/marketing_erp"

# ── Redis (BullMQ) ────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── NextAuth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
NEXTAUTH_SECRET="your-secret-here"
# Must match actual domain in production
NEXTAUTH_URL="https://marketing.erp.io"

# ── Google OAuth (login + GSC/GA4 data access) ────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Credential encryption ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY="your-64-char-hex-key"

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@erp.io"

# ── erp.io ecosystem URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://marketing.erp.io"
NEXT_PUBLIC_DASHBOARD_URL="https://dashboard.erp.io"

# ── Social OAuth (add as you build each integration) ──────────────────────
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# TWITTER_CLIENT_ID=""
# TWITTER_CLIENT_SECRET=""

# ── Meta (Facebook Pages + Instagram) — lib/integrations/meta.ts ──────────
# developers.facebook.com/apps → your app → Facebook Login → Settings:
# add https://app.erp.io/marketing/api/integrations/meta/callback as a Valid
# OAuth Redirect URI. Requesting pages_manage_posts / instagram_content_publish
# etc. beyond the app's own testers needs Meta App Review (Advanced Access).
META_APP_ID=""
META_APP_SECRET=""

# ── Microsoft 365 (Outlook mail) — lib/integrations/microsoft.ts ──────────
# entra.microsoft.com → App registrations → new registration (multitenant +
# personal accounts, so tenant "common" works): redirect URI (Web platform)
# https://app.erp.io/marketing/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
