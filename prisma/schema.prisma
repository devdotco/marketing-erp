generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth adapter models ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String            @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  referralSource String? // e.g. "digitalmarketers.ai"
  /// The app.erp.io shell user (`VibeUser.id`) this account IS. The identity join for the
  /// Marketing/CRM mirror and the hand-off: set at first link — by shell id, else by a VERIFIED
  /// email — and never moved to another shell user. Null = no shell user has claimed this account;
  /// the mirror never removes memberships from those. See lib/shell-mirror.
  shellUserId    String?           @unique
  accounts       Account[]
  sessions       Session[]
  memberships    WorkspaceMember[]
  invitations    Invitation[]      @relation("InvitedBy")
  notifications  Notification[]
  createdAt      DateTime          @default(now())
}

// ─── Workspaces ────────────────────────────────────────────────────────────

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  /// The app.erp.io organisation this workspace mirrors. Null for workspaces
  /// created here before the shell hand-off existed, and for any created by
  /// local sign-up — they are not wrong, they simply have no counterpart.
  shellOrgId        String?            @unique
  plan              WorkspacePlan      @default(FREE)
  members           WorkspaceMember[]
  agentConfigs      AgentConfig[]
  runs              AgentRun[]
  integrations      Integration[]
  invitations       Invitation[]
  businessProfile   BusinessProfile?
  notifications     Notification[]
  oauthStates       OAuthState[]
  outboundPlays     OutboundPlay[]
  outboundProspects OutboundProspect[]
  socialAccounts    SocialAccount[]
  socialPosts       SocialPost[]
  editorialProfile  EditorialProfile?
  generatedAssets   GeneratedAsset[]
  trackedPrompts    TrackedPrompt[]
  answerCaptures    AnswerCapture[]
  competitors       Competitor[]
  observations      Observation[]
  /// Whether this workspace may fall back to the platform's own Anthropic key.
  /// Off by default: every tenant brings its own, so model spend lands on the
  /// account that asked for the work. Only a super admin turns this on, and
  /// only for workspaces we operate ourselves.
  allowPlatformKey  Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum WorkspacePlan {
  FREE
  PRO
  ENTERPRISE
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole @default(VIEWER)
  /// Where this membership came from: `mirror` (pushed by the shell, which may remove it), `app`
  /// (invited or created here — the mirror never removes it) or `legacy` (predates the mirror;
  /// never removed by it). Owner decision 2026-09-14: in-app invites stay.
  source      String     @default("app")
  createdAt   DateTime   @default(now())

  @@unique([workspaceId, userId])
}

enum MemberRole {
  SUPER_ADMIN
  WORKSPACE_ADMIN
  OPERATOR
  VIEWER
}

// ─── Agent configuration ───────────────────────────────────────────────────

model AgentConfig {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentSlug   String
  enabled     Boolean    @default(false)
  config      Json       @default("{}")
  schedule    String?
  runs        AgentRun[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, agentSlug])
}

// ─── Agent runs ───────────────────────────────────────────────────────────

model AgentRun {
  id            String      @id @default(cuid())
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  agentConfigId String
  agentConfig   AgentConfig @relation(fields: [agentConfigId], references: [id])
  status        RunStatus   @default(PENDING)
  input         Json?
  output        Json?
  metadata      Json?
  costUsd       Decimal     @default(0) @db.Decimal(10, 6)
  triggeredBy   String?
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  /// The run that enqueued this one automatically — currently only the Outbound Engine's
  /// Scout → Strategist → (Email Outbound + LinkedIn Outbound) pipeline chaining
  /// (lib/agent-handlers/chaining.ts). Null for every run started directly (by a person, a
  /// schedule, or a webhook) — which is every run created before this column existed.
  parentRunId   String?
  parentRun     AgentRun?   @relation("AgentRunChain", fields: [parentRunId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childRuns     AgentRun[]  @relation("AgentRunChain")

  /// At most one child run per agent per parent — chaining.ts relies on this to make enqueuing a
  /// child idempotent (a unique-constraint violation on create means "already chained", not an
  /// error) instead of a check-then-create race. Postgres treats NULL parentRunId values as
  /// distinct, so this constrains nothing for the vast majority of runs, which have no parent.
  @@unique([parentRunId, agentConfigId])
}

enum RunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

// ─── Integrations ─────────────────────────────────────────────────────────

model Integration {
  id                   String              @id @default(cuid())
  workspaceId          String
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider             IntegrationProvider
  label                String?
  encryptedCredentials String
  scopes               String[]
  expiresAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([workspaceId, provider])
}

enum IntegrationProvider {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ADS
  GOOGLE_ANALYTICS_4
  GOOGLE_BUSINESS_PROFILE
  LINKEDIN
  META
  TWITTER_X
  YOUTUBE
  REDDIT
  WORDPRESS
  STORYBLOK
  WEBFLOW
  PAYLOAD
  MAILCHIMP
  KLAVIYO
  AHREFS
  SEMRUSH
  SEARCH_ATLAS
  CARTESIA
  TRANSISTOR
  GMAIL
  MICROSOFT_365
  INSTANTLY
  AIMFOX
  ZOOMINFO
  APOLLO
  GO_HIGH_LEVEL
  ANTHROPIC
  /// erp.io CRM (app.erp.io/crm) — per-tenant API key created in that CRM.
  /// Lets Email Marketing stage sequences/enrollments there in addition to
  /// Mailchimp/Klaviyo/Instantly/Apollo. See lib/integrations/crm-erp-io.ts.
  CRM_ERP_IO
  /// Answer-engine keys for AI visibility capture (lib/answer-engines/*).
  /// Captures are BYOK like every other model call: we measure the engines a
  /// workspace has paid to reach, and refuse the rest rather than guess.
  OPENAI
  GOOGLE_GEMINI
  PERPLEXITY
  /// Bring-your-own-key image generation for the Blog Writer's AI-generated
  /// image blocks. See lib/images/*.
  OPENAI_IMAGES
  GOOGLE_IMAGES
  /// Google's Gemini API text-to-speech — the Podcast agent's alternative
  /// voice provider to Cartesia. AI Studio API key. See lib/voice/google-tts.ts.
  GOOGLE_TTS
}

// ─── Invitations ──────────────────────────────────────────────────────────

model Invitation {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole
  token       String     @unique @default(cuid())
  invitedById String?
  invitedBy   User?      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
}

// ─── Business profile (populated by Onboarder agent) ─────────────────────

model BusinessProfile {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessName          String
  websiteUrl            String?
  industry              String?
  targetAudience        String?
  uniqueValueProp       String?
  brandVoice            Json?
  goals                 Json?
  competitors           String[]
  onboardingCompletedAt DateTime?
  onboardingStep        Int       @default(1)
  lastRefreshedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ─── Editorial ─────────────────────────────────────────────────────────────

/// How this workspace's written content is allowed to sound.
///
/// The content pipeline is an engine with no opinion of its own: every voice
/// rule, banned word, structural limit and sourcing rule it enforces comes from
/// here. `preset` names a starting point shipped in lib/content/editorial.ts;
/// `overrides` holds whatever the workspace changed on top of it. A workspace
/// with no row uses the neutral default.
model EditorialProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  preset      String    @default("neutral-professional")
  overrides   Json      @default("{}")
  updatedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Notifications ────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  type        String
  title       String
  body        String
  runId       String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}

// ─── OAuth PKCE state storage ─────────────────────────────────────────────

model OAuthState {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  state        String    @unique
  provider     String
  codeVerifier String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
}

// ─── Outbound Engine ─────────────────────────────────────────────────────────

enum OutboundChannel {
  EMAIL_AND_LINKEDIN
  EMAIL_ONLY
  WATCHLIST
  DISCARDED
}

enum OutboundStatus {
  PENDING
  IN_SEQUENCE
  REPLIED
  INTERESTED
  NOT_INTERESTED
  MEETING_BOOKED
  CONVERTED
  SUPPRESSED
}

model OutboundPlay {
  id          String             @id @default(cuid())
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  enabled     Boolean            @default(true)
  config      Json               @default("{}")
  prospects   OutboundProspect[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([workspaceId, slug])
}

model OutboundProspect {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playId            String
  play              OutboundPlay    @relation(fields: [playId], references: [id])
  firstName         String
  lastName          String?
  email             String
  linkedInUrl       String?
  title             String?
  company           String
  companyDomain     String?
  score             Int             @default(0)
  channel           OutboundChannel @default(EMAIL_ONLY)
  status            OutboundStatus  @default(PENDING)
  intelligence      Json?
  /// Apollo.io organization/person/job-postings enrichment the Strategist fetched for this
  /// prospect, each keyed section carrying its own `fetchedAt` so a freshness window (default 30
  /// days) decides whether a later run re-spends a credit or reuses this. Never contains a
  /// personal email or phone reveal — see lib/agent-handlers/outbound-strategist.ts.
  apolloEnrichment  Json?
  /// The buying signal this prospect was SOURCED on, as opposed to what the Strategist concluded
  /// (`intelligence`) or what Apollo said about them (`apolloEnrichment`). Written by Outbound
  /// Scout at sourcing time and read back by the Strategist, which puts it in front of the model
  /// as verified, citable source data. Today only the SEC Form D capital-raise sourcing mode sets
  /// it — `{ source: "sec_form_d", primarySignal, additionalSignals, secFormD: { cik, accession,
  /// filedAt, offeringAmount, amountSold, industryGroup, url } }`. NULL for every prospect sourced
  /// by ICP search, which is every prospect created before this column existed.
  sourceSignal      Json?
  instantlyLeadId   String?
  aimfoxLeadId      String?
  /// The erp.io CRM records Outbound Revenue wrote for this prospect (app.erp.io/crm): the
  /// `Person`, and the `Deal` opened from their first qualifying engagement. One deal per prospect
  /// — the CRM keys it on this prospect's id, so a second engagement moves that deal rather than
  /// opening another.
  crmPersonId       String?
  crmDealId         String?
  /// GoHighLevel, retired 2026-09. Kept only so the ids of records written before the move aren't
  /// lost; nothing reads them. See lib/agent-handlers/outbound-revenue.ts.
  ghlContactId      String?
  ghlOpportunityId  String?
  emailRepliedAt    DateTime?
  linkedInRepliedAt DateTime?
  interestedAt      DateTime?
  meetingBookedAt   DateTime?
  excludedAt        DateTime?
  excludeUntil      DateTime?
  exclusionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, email])
}

/// One Instantly / Aimfox webhook delivery already acted on — the idempotency record that stops a
/// vendor retry from applying the same event twice or starting a second Outbound Revenue run.
/// `dedupeKey` is a sha256 (no address in it) of the vendor's event id, else prospect + event +
/// the vendor's timestamp — see lib/webhooks/outbound-events.ts. Deliberately no relation to
/// Workspace: it holds nothing but hashes and needs no back-reference on that model.
model WebhookReceipt {
  id          String   @id @default(cuid())
  workspaceId String
  provider    String
  dedupeKey   String
  eventType   String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, provider, dedupeKey])
}

// ── Social Publishing ─────────────────────────────────────────────────────────

enum SocialPlatform {
  LINKEDIN
  TWITTER_X
}

enum SocialAccountType {
  PERSONAL
  COMPANY
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model SocialAccount {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform          SocialPlatform
  accountType       SocialAccountType @default(PERSONAL)
  platformAccountId String
  displayName       String
  username          String?
  headline          String?
  avatarUrl         String?
  platformEmail     String?
  organizationUrn   String?
  companyName       String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime
  scopes            String?
  posts             SocialPost[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([workspaceId, platform, platformAccountId])
}

model SocialPost {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  content         String
  mediaUrls       Json             @default("[]")
  status          SocialPostStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  errorMessage    String?
  aiGenerated     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ─── Blog Writer AI images ────────────────────────────────────────────────

/// An AI-generated image (lib/images/*), stored directly since this app has
/// no S3/R2/blob storage anywhere else (checked before adding this). Served
/// back out to the run preview by an authenticated, workspace-scoped route
/// (app/api/assets/[id]/route.ts); a CMS publish reads `bytes` straight from
/// this table server-side to upload as that CMS's own media (see
/// lib/agent-handlers/blog-writer.ts).
model GeneratedAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Which run produced this. Not a hard foreign key to AgentRun — a run
  /// failing after images were generated should not cascade-delete the bytes
  /// a retry could otherwise reuse.
  runId       String?
  mimeType    String
  bytes       Bytes
  alt         String
  prompt      String
  costUsd     Decimal?  @db.Decimal(10, 6)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, runId])
}

/// Last shell-mirror version applied per key (`org:<shellOrgId>`, `member:<shellOrgId>:<shellUserId>`).
/// A sidecar rather than a column so a REMOVED membership keeps its version: without that tombstone
/// a delayed, older "member added" event would put the person back. See lib/shell-mirror/apply.ts.
model ShellMirrorVersion {
  key       String   @id
  version   BigInt
  /// True when the last state applied for this member key was a REMOVAL — the tombstone the
  /// shell hand-off consults before it would recreate the membership.
  removed   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}

/// Replay guard for signed service requests from the shell (`shell:<jti>`). One row per accepted
/// token until it has expired; pruned opportunistically.
model SignedRequestReceipt {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI search visibility — the measurement spine
//
// Until these tables existed, nothing in the product could answer "is this
// better than last week?". Every result any agent had ever produced lived as
// unstructured JSON on one AgentRun row, so nothing was comparable across
// runs, and the one agent that reported on AI search simulated its figures.
//
// The shape is deliberately narrow: a prompt we track, an answer an engine
// actually gave, the citations inside that answer, and a generic time-series
// row everything else is derived into. Views are built over Observation, so a
// new metric is a new row type rather than a new table.
// ─────────────────────────────────────────────────────────────────────────────

/// Which answer engines we can capture from. Adding one means adding a client
/// in lib/answer-engines/ and a per-workspace key — captures are BYOK, like
/// every other model call in this app.
enum AnswerEngine {
  CLAUDE
  GEMINI
  PERPLEXITY
  OPENAI
}

enum TrackedPromptSource {
  /// Typed in by a person.
  MANUAL
  /// Proposed by the model from the business profile, then kept.
  SUGGESTED
  /// Derived from a real Search Console query with impressions behind it.
  SEARCH_CONSOLE
}

/// A question we ask the engines on a schedule. The unit of measurement.
model TrackedPrompt {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  text        String
  /// Free-text grouping ("pricing", "alternatives") so visibility can be read
  /// by theme rather than one prompt at a time.
  topic       String?
  locale      String              @default("en-US")
  source      TrackedPromptSource @default(MANUAL)
  active      Boolean             @default(true)
  captures    AnswerCapture[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  /// One row per question per locale. Re-adding the same prompt updates it
  /// rather than splitting its history in two.
  @@unique([workspaceId, text, locale])
  @@index([workspaceId, active])
}

/// One engine's actual answer to one tracked prompt, at one moment.
///
/// `answerText` is kept in full on purpose. Every metric here is derived, and
/// derivations get corrected — brand-term matching especially. Keeping the
/// answer means a fix can be applied to history instead of only to captures
/// taken after the fix shipped.
model AnswerCapture {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promptId       String
  prompt         TrackedPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  engine         AnswerEngine
  /// The exact model id that answered. Visibility moves when an engine ships a
  /// new model, and without this the trend line has an unexplained step in it.
  model          String
  answerText     String
  citations      Citation[]
  /// Did the brand appear at all, by any of its terms?
  brandMentioned Boolean       @default(false)
  /// 1 = the first brand named in the answer. Null when not mentioned.
  brandRank      Int?
  /// POSITIVE | NEUTRAL | NEGATIVE | null when not classified.
  sentiment      String?
  /// Tracked competitors named in this answer, by competitor name.
  competitors    String[]
  costUsd        Decimal       @default(0) @db.Decimal(10, 6)
  /// The run that took this capture, when one did. Null for a manual capture.
  runId          String?
  capturedAt     DateTime      @default(now())

  /// The capture day, as YYYY-MM-DD in UTC. Written by the capture pipeline,
  /// not derived in SQL, so the uniqueness below is a plain index: one capture
  /// per prompt per engine per day. A re-run on the same day updates rather
  /// than double-counting, which is what makes a retry safe.
  capturedOn String

  @@unique([promptId, engine, capturedOn])
  @@index([workspaceId, capturedAt])
  @@index([workspaceId, engine, capturedAt])
}

/// A source an engine cited inside an answer. One row per link.
model Citation {
  id          String        @id @default(cuid())
  captureId   String
  capture     AnswerCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  /// Denormalised so the "which domains influence answers about us" view is a
  /// groupBy on one table rather than a join through captures on every read.
  workspaceId String
  domain      String
  url         String
  /// Order of appearance in the answer, 1-based.
  position    Int
  /// True when the domain is the workspace's own site.
  isOwned     Boolean       @default(false)
  capturedAt  DateTime      @default(now())

  @@index([workspaceId, domain, capturedAt])
  @@index([captureId])
}

/// A competitor to measure share of voice against.
///
/// BusinessProfile.competitors is a bare String[] of names, which is enough to
/// put in a prompt and not enough to measure: share of voice needs a stable
/// identity and the domain to recognise in a citation. Seeded from that array
/// the first time visibility runs.
model Competitor {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  domain      String?
  /// Other strings that mean this competitor in an answer.
  aliases     String[]
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name])
}

/// The generic time-series row. Everything chartable derives into this.
///
/// One table rather than one per metric: the dashboard, the trend arrows and
/// (later) the signal detectors all read the same shape, so adding "citation
/// share by engine" is a new `metric` value, not a migration.
model Observation {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// What the figure is about: "brand", a competitor name, a domain, a URL.
  subject      String
  /// What was measured: "visibility", "citation_share", "brand_rank",
  /// "sentiment_score", "answer_mentions".
  metric       String
  /// How it was sliced — { engine: "CLAUDE", topic: "pricing" }. Kept as JSON
  /// because the useful slices differ per metric and a column per slice would
  /// be mostly nulls.
  dimensions   Json      @default("{}")
  /// The same slice as a stable string ("engine=CLAUDE;topic=pricing", keys
  /// sorted, empty string for no slice). Postgres cannot put a JSON column in
  /// a unique index, and without one a recompute APPENDS a second row for the
  /// same day instead of correcting the first — which is how a trend line
  /// quietly doubles. Written by recordObservations(); never set it by hand.
  dimensionKey String    @default("")
  value        Float
  /// Which system the figure came from, mirroring lib/agents/grounding.ts's
  /// evidence sources: "ANSWER_CAPTURE", "GSC", "CRAWL_LOGS".
  source       String
  /// The UTC day this figure describes, YYYY-MM-DD. One row per subject +
  /// metric + dimensions + day; a recompute overwrites rather than appends.
  observedOn   String
  observedAt   DateTime  @default(now())

  /// One figure per subject + metric + slice + day. Makes a recompute an
  /// upsert, so re-running a capture corrects the day rather than duplicating it.
  @@unique([workspaceId, subject, metric, dimensionKey, observedOn])
  @@index([workspaceId, metric, observedOn])
  @@index([workspaceId, subject, metric, observedOn])
}
